PORT=5000

# Supabase is used only by the Express backend.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the React frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
FIREBASE_PROJECT_ID=fu-service

# Resend email delivery. The default sender works for initial Resend testing.
# Replace it with an address on your verified domain before production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=fixOindia <onboarding@resend.dev>
RESEND_SUPPORT_TO=
# Optional: send review alerts somewhere else. Falls back to RESEND_SUPPORT_TO.
RESEND_REVIEW_TO=anything@moreumelaa.resend.app

# WhatsApp booking notifications. Use Cloud API for direct sending, or a custom webhook fallback.
WHATSAPP_AGENT_PHONE=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_AGENT_WEBHOOK_URL=

# WhatsApp agent (incoming messages + auto-replies).
# Set the same verify token in the Meta developer console when subscribing
# the webhook URL: https://<your-backend>/api/whatsapp/webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional AI-powered replies for messages the rule-based agent can't answer.
ANTHROPIC_API_KEY=
WHATSAPP_AI_MODEL=claude-3-5-haiku-latest

# Optional owner bootstrap. Set these before first backend start to create/update the owner login.
# The bootstrapped account receives role "owner" (full admin panel access).
ADMIN_NAME=fixOindia Control
ADMIN_USER_ID=admin@7074
ADMIN_EMAIL=khanfaizan24063@gmail.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=Admin@12345
ADMIN_PASSWORD_RESET_ON_START=true
